# Base URL of the PAZ sideband API, WITHOUT /sideband/request
SERVICE_URL=https://paz.example.com
# Sideband shared secret value (sent in the PDG-TOKEN header)
SECRET_HEADER_VALUE=<generate-a-random-secret>
# Per-attempt sideband call timeout, milliseconds (default 2000).
# 2 attempts x 2s = 4s worst case, inside the gateway's 5s extAuthz timeout.
SIDEBAND_TIMEOUT_MS=2000
# Structured diagnostics; masks secrets. Keep false in production.
DEBUG_LOGGING=false
# gRPC listen port for the adapter (default 8082)
LISTEN_PORT=8082
