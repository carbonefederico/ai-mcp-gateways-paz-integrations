-27b9147092b2","version":"b5e0a7e6-3108-4c96-bd9d-1162651bf98e","type":"Statement","name":"Approval Required","description":"","shared":false,"code":"denied-reason","appliesTo":"ANYTHING","appliesIf":"PATH_MATCHES","payload":"{\"status\":403, \"message\": \"approval_required\", \"detail\":\"This change requires human approval\"}","obligatory":false,"permissions":{"inherit":true,"rolePermissions":[]},"services":[],"attributes":[]},{"id":"c8ab05b7-2dba-4697-98d1-f5e3809a0c1a","version":"ea880ff0-4791-4391-8964-d692517e4190","type":"Statement","name":"Delegation Not Permitted","description":"","shared":false,"code":"denied-reason","appliesTo":"ANYTHING","appliesIf":"PATH_MATCHES","payload":"{\"status\":403, \"message\": \"delegation_not_permitted\", \"detail\":\"This subject is not authorized to operate this agent\"}","obligatory":false,"permissions":{"inherit":true,"rolePermissions":[]},"services":[],"attributes":[]},{"id":"1c93ee51-44ec-4ad3-8bee-bc3f58a06b15","version":"b5c4d99a-f164-4a59-950b-9af83c6a3741","type":"Statement","name":"Exclude private data","description":"","shared":false,"code":"exclude-attributes","appliesTo":"ANYTHING","appliesIf":"PATH_MATCHES","payload":"[\"data.private\"]","obligatory":false,"permissions":{"inherit":true,"rolePermissions":[]},"services":[],"attributes":[]},{"id":"1fc6090f-bae7-457e-87b2-828d97578879","version":"117138f5-6c88-4ea6-96e5-73fe4d8330ac","type":"Statement","name":"Include all attributes","description":"Allows a client to read any attribute.","shared":true,"code":"include-attributes","appliesTo":"PERMIT","appliesIf":"PATH_MATCHES","payload":"[\"*\"]","obligatory":true,"permissions":{"inherit":true,"rolePermissions":[]},"services":[],"attributes":[]},{"id":"51119f2f-ab5b-4184-8108-53daeceb834f","version":"19c10521-2cea-4732-8417-04dfe2fb8c41","type":"Statement","name":"Include attributes permitted by scope","description":"","shared":false,"code":"include-attributes","appliesTo":"PERMIT","appliesIf":"PATH_MATCHES","paylo